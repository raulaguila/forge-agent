{
  "name": "forge-agent",
  "displayName": "Forge Agent",
  "description": "Agentic coding assistant with BYOK — OpenAI, OpenAI-compatible (TLS insecure), Ollama, Anthropic e Gemini.",
  "version": "0.15.4",
  "publisher": "forge-agent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "byok",
    "coding",
    "openai",
    "anthropic",
    "gemini",
    "ollama",
    "chatgpt",
    "claude"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forge-agent",
          "title": "Forge Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "forge-agent": [
        {
          "type": "webview",
          "id": "forgeAgent.chatView",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "forgeAgent.openChat",
        "title": "Forge Agent: Open Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "forgeAgent.setApiKey",
        "title": "Forge Agent: Open Settings (API Key / Profiles)"
      },
      {
        "command": "forgeAgent.clearApiKey",
        "title": "Forge Agent: Clear API Key"
      },
      {
        "command": "forgeAgent.newChat",
        "title": "Forge Agent: New Chat",
        "icon": "$(add)"
      },
      {
        "command": "forgeAgent.stopAgent",
        "title": "Forge Agent: Stop Agent",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forgeAgent.explainSelection",
        "title": "Forge Agent: Explain Selection"
      },
      {
        "command": "forgeAgent.editSelection",
        "title": "Forge Agent: Edit Selection"
      },
      {
        "command": "forgeAgent.cycleAutonomy",
        "title": "Forge Agent: Cycle Mode (Ask/Plan/Agent/Auto)",
        "icon": "$(shield)"
      },
      {
        "command": "forgeAgent.addSelectionToChat",
        "title": "Forge Agent: Add Selection to Chat",
        "icon": "$(mention)"
      },
      {
        "command": "forgeAgent.focusChatInput",
        "title": "Forge Agent: Focus Chat"
      },
      {
        "command": "forgeAgent.undoCheckpoint",
        "title": "Forge Agent: Undo Last Checkpoint",
        "icon": "$(discard)"
      },
      {
        "command": "forgeAgent.openRules",
        "title": "Forge Agent: Open Project Rules (.forge/rules.md)",
        "icon": "$(book)"
      },
      {
        "command": "forgeAgent.openSettings",
        "title": "Forge Agent: Open Settings",
        "icon": "$(gear)"
      },
      {
        "command": "forgeAgent.switchProfile",
        "title": "Forge Agent: Open Settings (Switch Profile)",
        "icon": "$(organization)"
      },
      {
        "command": "forgeAgent.pickModel",
        "title": "Forge Agent: Pick Model (active provider)",
        "icon": "$(symbol-misc)"
      },
      {
        "command": "forgeAgent.manageProfiles",
        "title": "Forge Agent: Open Settings (Profiles)"
      },
      {
        "command": "forgeAgent.showLogs",
        "title": "Forge Agent: Show Logs",
        "icon": "$(output)"
      }
    ],
    "keybindings": [
      {
        "command": "forgeAgent.openChat",
        "key": "ctrl+shift+i",
        "mac": "cmd+shift+i"
      },
      {
        "command": "forgeAgent.addSelectionToChat",
        "key": "ctrl+shift+l",
        "mac": "cmd+shift+l",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "forgeAgent.stopAgent",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace"
      },
      {
        "command": "forgeAgent.cycleAutonomy",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "forgeAgent.newChat",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "forgeAgent.chatView.focus || view == forgeAgent.chatView"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "forgeAgent.openSettings",
          "when": "view == forgeAgent.chatView",
          "group": "navigation"
        },
        {
          "command": "forgeAgent.newChat",
          "when": "view == forgeAgent.chatView",
          "group": "navigation"
        },
        {
          "command": "forgeAgent.stopAgent",
          "when": "view == forgeAgent.chatView",
          "group": "navigation"
        },
        {
          "command": "forgeAgent.cycleAutonomy",
          "when": "view == forgeAgent.chatView",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "forgeAgent.explainSelection",
          "when": "editorHasSelection",
          "group": "forgeAgent@1"
        },
        {
          "command": "forgeAgent.editSelection",
          "when": "editorHasSelection",
          "group": "forgeAgent@2"
        }
      ],
      "commandPalette": [
        {
          "command": "forgeAgent.openChat"
        },
        {
          "command": "forgeAgent.openSettings"
        },
        {
          "command": "forgeAgent.setApiKey"
        },
        {
          "command": "forgeAgent.clearApiKey"
        },
        {
          "command": "forgeAgent.openRules"
        },
        {
          "command": "forgeAgent.switchProfile"
        },
        {
          "command": "forgeAgent.pickModel"
        },
        {
          "command": "forgeAgent.manageProfiles"
        },
        {
          "command": "forgeAgent.showLogs"
        }
      ]
    },
    "configuration": {
      "title": "Forge Agent",
      "properties": {
        "forgeAgent.provider": {
          "type": "string",
          "enum": [
            "openai",
            "openai-compatible",
            "ollama",
            "anthropic",
            "gemini"
          ],
          "enumDescriptions": [
            "OpenAI oficial (api.openai.com)",
            "Qualquer endpoint /v1/chat/completions (OpenRouter, Groq, Azure, proxies…)",
            "Ollama local ou remoto (/api/chat)",
            "Anthropic Claude",
            "Google Gemini"
          ],
          "default": "openai",
          "description": "Provedor LLM (BYOK)."
        },
        "forgeAgent.model": {
          "type": "string",
          "default": "gpt-4o",
          "description": "Modelo (ex.: gpt-4o, claude-sonnet-4-20250514, gemini-2.0-flash, llama3.1)."
        },
        "forgeAgent.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL. Obrigatória para openai-compatible. Defaults: OpenAI api.openai.com/v1, Ollama http://localhost:11434, Anthropic api.anthropic.com, Gemini generativelanguage.googleapis.com/v1beta."
        },
        "forgeAgent.tlsInsecure": {
          "type": "boolean",
          "default": false,
          "description": "Desabilita verificação do certificado TLS (self-signed / proxy corporativo). Use principalmente com openai-compatible em HTTPS interno."
        },
        "forgeAgent.autonomy": {
          "type": "string",
          "enum": [
            "ask",
            "plan",
            "agent",
            "auto"
          ],
          "enumDescriptions": [
            "Ask — perguntas sobre o repo com tools de leitura (sem editar)",
            "Plan — investiga e gera um plano Markdown",
            "Agent — writes via diff com aprovação",
            "Auto — aplica writes automaticamente (terminal ainda pode pedir aprovação)"
          ],
          "default": "agent",
          "description": "Modo do chat: Ask / Plan / Agent / Auto."
        },
        "forgeAgent.maxToolRounds": {
          "type": "number",
          "default": 25,
          "minimum": 1,
          "maximum": 100,
          "description": "Máximo de rounds de tools por mensagem do usuário."
        },
        "forgeAgent.autoApproveReads": {
          "type": "boolean",
          "default": true,
          "description": "Aprovar automaticamente tools de leitura (read_file, list_dir, search, diagnostics)."
        },
        "forgeAgent.requireApprovalForWrites": {
          "type": "boolean",
          "default": true,
          "description": "Pedir aprovação antes de write_file / apply_edit."
        },
        "forgeAgent.requireApprovalForTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Pedir aprovação antes de run_terminal."
        },
        "forgeAgent.systemPromptExtra": {
          "type": "string",
          "default": "",
          "description": "Instruções extras anexadas ao system prompt do agent."
        },
        "forgeAgent.temperature": {
          "type": "number",
          "default": 0.2,
          "minimum": 0,
          "maximum": 2,
          "description": "Temperature do modelo."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/raulaguila/forge-agent.git"
  },
  "homepage": "https://github.com/raulaguila/forge-agent#readme",
  "bugs": {
    "url": "https://github.com/raulaguila/forge-agent/issues"
  }
}
